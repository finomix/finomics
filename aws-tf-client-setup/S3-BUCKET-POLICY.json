{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowFocusDataExportWrite",
      "Effect": "Allow",
      "Principal": {
        "Service": "bcm-data-exports.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceOrgID": "<ORG_ID>"
        }
      }
    },
    {
      "Sid": "AllowFocusDataExportGetPolicy",
      "Effect": "Allow",
      "Principal": {
        "Service": "bcm-data-exports.amazonaws.com"
      },
      "Action": "s3:GetBucketPolicy",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringEquals": {
          "aws:SourceOrgID": "<ORG_ID>"
        }
      }
    },
    {
      "Sid": "AllowOrgAccountsWrite",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "<ORG_ID>"
        }
      }
    },
    {
      "Sid": "AllowOrgAccountsList",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "<ORG_ID>"
        }
      }
    },
    {
      "Sid": "AllowPipelineRoleAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::364582896484:role/finomics_data_pipeline_role"
      },
      "Action": [
        "s3:GetObject",
        "s3:ListBucket",
        "s3:GetBucketVersioning",
        "s3:GetBucketPolicyStatus",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET_NAME>",
        "arn:aws:s3:::<BUCKET_NAME>/*"
      ]
    }
  ]
}
